# aiagent makeself startup script (body; prepended at build time with
# #!/bin/sh + AIAGENT_VERSION= + PYVER=).
#
# makeself (built with --nox11 --nocomp) extracts this dir to a temp location and
# runs this script from there, as `sh ./startup.sh` (never exec'd directly: the
# temp dir may be mounted noexec). The dir contains:
#   ./zstd            a bundled STATIC zstd (so the target needs no zstd)
#   ./bundle.tar.zst  the zstd-compressed CPython + aiagent + deps tree
#
# We decompress with the bundled zstd, then lay the tree into an install prefix
# and expose `aiagent`. Install prefix resolution (highest first):
#   1. `--prefix DIR`  (pass as: sh aiagent-install.sh -- --prefix DIR)
#   2. $AIAGENT_PREFIX
#   3. $HOME/.local
# (`--target` is makeself's own option: it keeps the raw payload in DIR.)
set -eu

# makeself runs us under umask 077. The installed tree is software for every user
# of the prefix (e.g. /usr/local): readable and runnable by all, writable by the
# installing user only.
umask 022

usage() {
  echo "Usage: sh aiagent-install.sh [-- --prefix DIR]   (or set AIAGENT_PREFIX)"
}

PREFIX="${AIAGENT_PREFIX:-$HOME/.local}"
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix)
      if [ $# -lt 2 ]; then
        echo "error: --prefix needs a directory" >&2; usage >&2; exit 2
      fi
      PREFIX="$2"; shift 2 ;;
    --prefix=*) PREFIX="${1#*=}"; shift ;;
    -h|--help)
      echo "aiagent ${AIAGENT_VERSION} installer"
      usage
      exit 0 ;;
    *) echo "error: unknown option '$1'" >&2; usage >&2; exit 2 ;;
  esac
done
[ -n "$PREFIX" ] || { echo "error: empty install prefix" >&2; exit 2; }

# makeself runs this script inside its temp dir and deletes that afterwards: a
# relative prefix means the directory the installer was started from, which
# makeself exports as $USER_PWD. A quoted ~ means $HOME.
# shellcheck disable=SC2088  # a literal ~ is exactly what is matched here
case "$PREFIX" in
  /*) ;;
  '~'|'~/'*) PREFIX="$HOME${PREFIX#\~}" ;;
  *) PREFIX="${USER_PWD:-$PWD}/$PREFIX" ;;
esac

here="$(pwd)"                       # makeself extraction dir (zstd + bundle.tar.zst)

mkdir -p -- "$PREFIX"
PREFIX="$(CDPATH= cd -- "$PREFIX" && pwd)"
LIB="$PREFIX/lib/aiagent"
BINDIR="$PREFIX/bin"
DOCDIR="$PREFIX/share/doc/aiagent"

# The bundled interpreter every console script resolves to. `-I` (isolated mode)
# makes the bundle hermetic: PYTHONPATH, PYTHONHOME and the other PYTHON*
# variables, the user site and the script's directory never reach sys.path.
# The kernel splits a shebang at whitespace and cannot exec one over 127 bytes,
# so refuse such a prefix — before anything is unpacked or replaced.
BUNDLE_PY="$LIB/bin/python$PYVER"
shebang="#!$BUNDLE_PY -I"
tab="$(printf '\t')"
nl='
'
case "$BUNDLE_PY" in
  *" "*|*"$tab"*|*"$nl"*)
    echo "error: install path '$PREFIX' contains whitespace, which a '#!' line cannot" >&2
    echo "       carry. Re-run with AIAGENT_PREFIX (or -- --prefix DIR) set to a path without it." >&2
    exit 1 ;;
esac
if [ ${#shebang} -gt 127 ]; then
  echo "error: install path too long — shebang '$shebang' is ${#shebang} bytes" >&2
  echo "       (kernel limit 127). Re-run with a shorter AIAGENT_PREFIX (or -- --prefix DIR)." >&2
  exit 1
fi

echo "Installing aiagent ${AIAGENT_VERSION} -> $PREFIX"

# Decompress the heavy payload with the BUNDLED static zstd (target needs none).
# Stage on the SAME filesystem as the target for a fast rename, and run zstd from
# there too: makeself's temp dir may be mounted noexec.
stage="$PREFIX/.aiagent-install.$$"
rm -rf "$stage"; mkdir -p "$stage"
trap 'rm -rf "$stage"' EXIT INT TERM
cp "$here/zstd" "$stage/.zstd"
chmod 700 "$stage/.zstd"
# --no-same-owner: as root, tar would otherwise restore the archive's owner.
"$stage/.zstd" -dc "$here/bundle.tar.zst" | tar --no-same-owner -xf - -C "$stage"   # -> stage/python, stage/doc
rm -f "$stage/.zstd"
# Whoever installs owns the tree (root included); everyone may read and run it.
chmod -R u+rwX,go+rX,go-w "$stage"

# Before anything is replaced: the bundled interpreter must run on this host
# (x86-64 glibc >= 2.17, and a prefix that is not mounted noexec). `import
# aiagent` only reads package metadata; it does not pull in dspy.
if ! "$stage/python/bin/python$PYVER" -I -c 'import aiagent' >/dev/null 2>&1; then
  echo "error: the bundled Python cannot run on this host. It needs Linux x86-64 with" >&2
  echo "       glibc >= 2.17 (not musl), and a prefix that is not mounted noexec." >&2
  exit 1
fi

mkdir -p "$BINDIR" "$PREFIX/lib" "$PREFIX/share/doc"
rm -rf "$LIB"; mv "$stage/python" "$LIB"
if [ -d "$stage/doc" ]; then rm -rf "$DOCDIR"; mv "$stage/doc" "$DOCDIR"; fi

# Repoint console-script shebangs (pip stamped a build-time path) at the bundled
# interpreter on THIS machine. grep -I skips the interpreter binary.
for f in "$LIB"/bin/*; do
  [ -f "$f" ] || continue
  grep -Iqm1 '^#!.*python' "$f" 2>/dev/null || continue
  tmp="$f.aiagent-fix.$$"
  { printf '%s\n' "$shebang"; tail -n +2 "$f"; } > "$tmp"
  chmod 755 "$tmp"; mv "$tmp" "$f"
done

# Only `aiagent` goes on PATH. The bundled interpreter deliberately does NOT:
# $BINDIR is normally ~/.local/bin, which sits ahead of /usr/bin for most users,
# so linking it there as python$PYVER shadowed the host's own python$PYVER for
# every command in the shell — with an interpreter that is sourceless, carries
# aiagent's site-packages, and has had pip/setuptools stripped. Console scripts
# do not need the link: their shebangs were rewritten above to $BUNDLE_PY as an
# absolute path.
ln -sf "$LIB/bin/aiagent" "$BINDIR/aiagent"

# Installers up to 0.3.0 created that link, so an upgrade has to remove it or
# the shadowing survives. Only ever remove a symlink that still points into our
# own $LIB — never a python the user put there.
stale="$BINDIR/python$PYVER"
removed_stale=""
if [ -L "$stale" ]; then
  case "$(readlink "$stale" 2>/dev/null || true)" in
    "$LIB"/*) rm -f "$stale" && removed_stale=1 ;;
  esac
fi

echo "Installed:"
echo "  $BINDIR/aiagent      ->  $LIB/bin/aiagent  (Python console script)"
echo "  $LIB/  (CPython $PYVER + aiagent + deps, sourceless precompiled)"
if [ -n "$removed_stale" ]; then
  echo "Removed:"
  echo "  $stale  (older installers put the bundled interpreter on PATH,"
  echo "   where it shadowed the host's own python$PYVER; aiagent never needed it)"
fi
case ":${PATH}:" in
  *":$BINDIR:"*) echo "Run: aiagent --help" ;;
  *) echo "Add $BINDIR to PATH:  export PATH=\"$BINDIR:\$PATH\"" ;;
esac
